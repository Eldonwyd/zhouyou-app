{
  "name": "travel-footprints-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:phone": "vite --host 0.0.0.0 --port 5175 --configLoader runner",
    "build": "tsc --noEmit && vite build && node scripts/write-precache.mjs",
    "preview": "node server/index.mjs --production",
    "check": "tsc --noEmit",
    "test:maps": "node scripts/validate-maps.mjs",
    "test:web": "node scripts/smoke.mjs",
    "test:migration": "node scripts/migration-smoke.mjs",
    "test:finance": "node scripts/finance-smoke.mjs",
    "test:city-record": "node scripts/city-record-smoke.mjs",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:visit-confirm": "node scripts/visit-confirm-smoke.mjs",
    "start": "node server/index.mjs --production",
    "test:planner:live": "node scripts/planner-live.mjs",
    "setup:xhs": "node --use-system-ca scripts/setup-xhs.mjs --install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@zip.js/zip.js": "^2.8.0",
    "echarts": "^6.1.0",
    "exifr": "^7.1.3",
    "jsonrepair": "3.15.0",
    "leaflet": "^1.9.4",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
