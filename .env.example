# Server only. Copy to .env.local; never prefix credentials with VITE_.
DEEPSEEK_API_KEY=
# 可选：全网图片索引搜索（Brave Images）。未配置也会使用开放图库图片搜索和公开网页补图。
# 仅服务端使用；费用和配额按该服务商账号实际方案计算。
BRAVE_IMAGE_SEARCH_KEY=
# 本地小红书连接工具安装脚本生成；只连接回环地址，Token 不能放到前端。
XHS_BRIDGE_URL=
XHS_BRIDGE_TOKEN=
# 可选：高德 Web 服务类型 Key，仅服务端使用，用于真实地点检索。
# 未配置时，行程地图会保留地点列表和高德搜索链接，并显示“位置待确认”。
AMAP_WEB_SERVICE_KEY=
# 可选：替换底图服务；必须使用 WGS84 / Web Mercator 瓦片，并遵循供应商政策。
PLANNER_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# 平台免费体验 AI（仅 Cloudflare Pages Secret / 服务端环境变量使用，严禁提交到仓库或暴露给前端）
FREE_AI_API_KEY=
FREE_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FREE_AI_MODEL=glm-5.3-flash
FREE_AI_USER_DAILY_TOKENS=50000
FREE_AI_USER_MONTHLY_TOKENS=120000
FREE_AI_SITE_DAILY_TOKENS=500000
FREE_AI_VIP_ACCOUNTS=
# 开发者监控后台安全密钥（仅配置在 Cloudflare Pages Secret 与本地 admin-dashboard/.env.local）
ADMIN_API_KEY=
# 可选：GitHub Fine-grained PAT（读取仓库 Traffic 浏览量/克隆量）
GITHUB_TOKEN=
